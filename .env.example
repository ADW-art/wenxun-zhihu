# PostgreSQL connection used by Prisma and the application.
DATABASE_URL="postgresql://wenxun:wenxun@localhost:5432/wenxun?schema=public"

# Authentication.
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
AUTH_TRUST_HOST="true"

# Agent provider: mock, deepseek, openai-compatible, or ollama.
AGENT_PROVIDER="deepseek"
AGENT_MODEL="deepseek-v4-flash"
AGENT_BASE_URL="https://api.deepseek.com"
AGENT_API_KEY=""
AGENT_TIMEOUT_MS="30000"
DEEPSEEK_API_KEY=""

# File storage: local or s3.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="uploads"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Public application URL used for deployment and auth callbacks.
APP_URL="http://localhost:3000"
